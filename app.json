{
  "expo": {
    "name": "OctoLearn",
    "slug": "octolearn",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "octolearn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.octolearn.prototype",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.octolearn.prototype",
      "adaptiveIcon": {
        "backgroundColor": "#FFEEE3",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-video",
      ["expo-screen-orientation", { "initialOrientation": "PORTRAIT_UP" }],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#CC4C0A"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2701F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#F2701F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-localization",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ffa2fef4-693b-4672-83a0-d775b461a5ab"
      }
    },
    "owner": "olula",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ffa2fef4-693b-4672-83a0-d775b461a5ab"
    }
  }
}
