# Copy to .env for local development (bun run dev reads it). On Railway, set these as service variables.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Any local Postgres 16+ and Redis 7+ (e.g. Homebrew), or Railway's public URLs.
DATABASE_URL=postgres://octolearn:octolearn@127.0.0.1:5432/octolearn
REDIS_URL=redis://127.0.0.1:6379

# Clerk → API keys → "Show JWT public key" → PEM. Verifies session tokens with no network call.
# For local testing without Clerk: `bun run token -- --public-key` prints a dev key to paste here.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Optional fallback if CLERK_JWT_KEY is not set (fetches Clerk's JWKS).
# CLERK_SECRET_KEY=sk_test_...
# Optional: origins allowed in the token's `azp` claim (the web client, the admin dashboard).
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Clerk → Webhooks → endpoint signing secret, for /webhooks/clerk.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Browser origins allowed by CORS (comma separated). The mobile app needs none.
CORS_ORIGINS=http://localhost:5173

# Protects /metrics and /internal/stats (16+ chars). Without it they are closed in production.
# METRICS_TOKEN=change-me-to-a-long-random-string

# Tuning (defaults shown)
# DATABASE_POOL_MAX=10
# RATE_LIMIT_MAX=300
# RATE_LIMIT_USER_MAX=120
# MAX_IN_FLIGHT=256
# REQUEST_TIMEOUT_MS=15000
