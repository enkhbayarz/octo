{
  "name": "octolearn-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "predeploy": "node dist/db/migrate.js && node dist/db/seed.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "coverage": "vitest run --coverage",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:explain": "tsx --env-file-if-exists=.env scripts/explain.ts",
    "load": "tsx scripts/load-test.ts",
    "token": "tsx scripts/mint-token.ts",
    "smoke": "tsx scripts/smoke.ts",
    "clerk-token": "tsx scripts/clerk-token.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.6",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@scalar/hono-api-reference": "^0.12.17",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "jose": "^6.2.15",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "svix": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
